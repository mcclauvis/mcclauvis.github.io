---
import Layout from '../../layouts/Layout.astro';

const articles = [
  {
    title: 'Implémenter un ERP Odoo dans une PME de fabrication métallique',
    date: '26 août 2024',
    excerpt: 'Guide complet pour réussir l\'implémentation d\'Odoo dans le secteur de la fabrication métallique. Découvrez les bonnes pratiques, les pièges à éviter et les modules essentiels.',
    slug: 'erp-pme-fabrication-metallique',
    category: 'Implémentation',
    readTime: '8 min'
  },
  {
    title: 'Réussir son projet ERP en fabrication 2025',
    date: '8 janvier 2025',
    excerpt: 'Les meilleures pratiques et stratégies pour mener à bien un projet ERP dans l\'industrie manufacturière. Une approche méthodique pour garantir le succès de votre transformation digitale.',
    slug: 'reussir-projet-erp-fabrication-2025',
    category: 'Stratégie',
    readTime: '10 min'
  },
  {
    title: 'Les Nouveautés et Améliorations d\'Odoo 18',
    date: '6 décembre 2024',
    excerpt: 'Découvrez toutes les nouvelles fonctionnalités et améliorations apportées par Odoo 18. Des améliorations de performance aux nouvelles interfaces utilisateur.',
    slug: 'nouveautes-odoo-18',
    category: 'Actualités',
    readTime: '6 min'
  }
];

const categories = ['Tous', 'Implémentation', 'Stratégie', 'Actualités', 'Tutoriels'];
---

<Layout title="Blog | Minoumissek Cedrigue Clauvis">
  <section class="blog-hero">
    <div class="container">
      <div class="hero-content">
        <span class="hero-tag font-mono">Blog</span>
        <h1 class="hero-title">
          Articles & <span class="text-gradient">Insights</span>
        </h1>
        <p class="hero-subtitle">
          Partage de connaissances, retours d'expérience et actualités
          sur Odoo, les ERP et la transformation digitale.
        </p>
      </div>

      <div class="categories-filter">
        {categories.map((cat, index) => (
          <button
            class={`filter-btn ${index === 0 ? 'active' : ''}`}
            data-category={cat.toLowerCase()}
          >
            {cat}
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="articles-section">
    <div class="container">
      <div class="articles-grid">
        {articles.map((article, index) => (
          <article class="article-card" style={`animation-delay: ${index * 0.1}s`}>
            <div class="article-image">
              <div class="article-overlay">
                <span class="article-category">{article.category}</span>
              </div>
            </div>

            <div class="article-content">
              <div class="article-meta">
                <span class="article-date">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <rect x="3" y="4" width="18" height="18" rx="2" ry="2"/>
                    <line x1="16" y1="2" x2="16" y2="6"/>
                    <line x1="8" y1="2" x2="8" y2="6"/>
                    <line x1="3" y1="10" x2="21" y2="10"/>
                  </svg>
                  {article.date}
                </span>
                <span class="article-read-time">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/>
                    <polyline points="12 6 12 12 16 14"/>
                  </svg>
                  {article.readTime}
                </span>
              </div>

              <h2 class="article-title">
                <a href={`/blog/${article.slug}`}>{article.title}</a>
              </h2>

              <p class="article-excerpt">{article.excerpt}</p>

              <a href={`/blog/${article.slug}`} class="article-link">
                Lire l'article
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="12,5 19,12 12,19"/>
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>

      <!-- Newsletter -->
      <div class="newsletter-card">
        <div class="newsletter-content">
          <div class="newsletter-icon">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
              <polyline points="22,6 12,13 2,6"/>
            </svg>
          </div>
          <div class="newsletter-text">
            <h3>Restez informé</h3>
            <p>Recevez les derniers articles et actualités Odoo directement dans votre boîte mail.</p>
          </div>
        </div>
        <form class="newsletter-form">
          <input type="email" placeholder="votre@email.com" class="newsletter-input" />
          <button type="submit" class="btn btn-primary">S'abonner</button>
        </form>
      </div>
    </div>
  </section>
</Layout>

<style>
  .blog-hero {
    padding: calc(72px + var(--space-4xl)) 0 var(--space-3xl);
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
  }

  .hero-content {
    text-align: center;
    max-width: 700px;
    margin: 0 auto var(--space-3xl);
  }

  .hero-tag {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--accent-primary);
    margin-bottom: var(--space-md);
    letter-spacing: 0.1em;
  }

  .hero-title {
    font-size: var(--text-5xl);
    font-weight: 800;
    margin-bottom: var(--space-lg);
    line-height: 1.1;
  }

  .hero-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Categories Filter */
  .categories-filter {
    display: flex;
    justify-content: center;
    gap: var(--space-sm);
    flex-wrap: wrap;
  }

  .filter-btn {
    padding: var(--space-sm) var(--space-lg);
    background: transparent;
    border: 1px solid var(--border-color);
    border-radius: 100px;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
  }

  .filter-btn:hover {
    border-color: var(--accent-primary);
    color: var(--accent-primary);
  }

  .filter-btn.active {
    background: var(--accent-gradient);
    border-color: transparent;
    color: white;
  }

  /* Articles Section */
  .articles-section {
    padding: var(--space-4xl) 0;
  }

  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-xl);
    margin-bottom: var(--space-4xl);
  }

  .article-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    overflow: hidden;
    animation: fadeInUp 0.5s ease forwards;
    opacity: 0;
    transition: all var(--transition-base);
  }

  .article-card:hover {
    border-color: var(--accent-primary);
    transform: translateY(-6px);
    box-shadow: var(--shadow-glow);
  }

  .article-image {
    position: relative;
    height: 200px;
    background: linear-gradient(135deg, var(--bg-tertiary) 0%, var(--bg-primary) 100%);
    overflow: hidden;
  }

  .article-image::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent-gradient);
    opacity: 0.1;
  }

  .article-overlay {
    position: absolute;
    top: var(--space-md);
    left: var(--space-md);
  }

  .article-category {
    padding: var(--space-xs) var(--space-sm);
    background: var(--bg-primary);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--accent-primary);
  }

  .article-content {
    padding: var(--space-xl);
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: var(--space-lg);
    margin-bottom: var(--space-md);
  }

  .article-date,
  .article-read-time {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  .article-title {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-md);
    line-height: 1.3;
  }

  .article-title a {
    transition: color var(--transition-fast);
  }

  .article-title a:hover {
    color: var(--accent-primary);
  }

  .article-excerpt {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    line-height: 1.6;
    margin-bottom: var(--space-lg);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .article-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--accent-primary);
    transition: gap var(--transition-fast);
  }

  .article-link:hover {
    gap: var(--space-md);
  }

  /* Newsletter */
  .newsletter-card {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3xl);
    padding: var(--space-2xl) var(--space-3xl);
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-xl);
    position: relative;
    overflow: hidden;
  }

  .newsletter-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent-gradient);
    opacity: 0.03;
  }

  .newsletter-content {
    display: flex;
    align-items: center;
    gap: var(--space-xl);
  }

  .newsletter-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    background: rgba(0, 217, 255, 0.1);
    border-radius: var(--radius-lg);
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  .newsletter-text h3 {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-xs);
  }

  .newsletter-text p {
    font-size: var(--text-sm);
    color: var(--text-secondary);
    max-width: 400px;
  }

  .newsletter-form {
    display: flex;
    gap: var(--space-sm);
    position: relative;
    z-index: 1;
  }

  .newsletter-input {
    width: 280px;
    padding: var(--space-sm) var(--space-lg);
    background: var(--bg-primary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-md);
    font-size: var(--text-sm);
    color: var(--text-primary);
    transition: border-color var(--transition-fast);
  }

  .newsletter-input::placeholder {
    color: var(--text-muted);
  }

  .newsletter-input:focus {
    outline: none;
    border-color: var(--accent-primary);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .articles-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .newsletter-card {
      flex-direction: column;
      text-align: center;
    }

    .newsletter-content {
      flex-direction: column;
    }

    .newsletter-text p {
      max-width: none;
    }
  }

  @media (max-width: 768px) {
    .hero-title {
      font-size: var(--text-3xl);
    }

    .articles-grid {
      grid-template-columns: 1fr;
    }

    .newsletter-form {
      flex-direction: column;
      width: 100%;
    }

    .newsletter-input {
      width: 100%;
    }
  }
</style>
