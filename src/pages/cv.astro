---
import Layout from '../layouts/Layout.astro';

const experiences = [
  {
    title: 'Développeur Odoo ERP Senior',
    company: 'Freelance',
    period: '2021 - Présent',
    description: 'Accompagnement des entreprises dans la personnalisation et l\'intégration d\'Odoo. Développement de modules sur mesure, migration de versions, et formation des équipes.',
    achievements: [
      'Plus de 15 projets Odoo menés avec succès',
      'Migration de systèmes legacy vers Odoo',
      'Intégration avec des systèmes tiers via API'
    ]
  },
  {
    title: 'Consultant ERP',
    company: 'Entreprises diverses',
    period: '2019 - 2021',
    description: 'Analyse des besoins métier, rédaction de cahiers des charges, et accompagnement dans le choix et l\'implémentation de solutions ERP.',
    achievements: [
      'Analyse et optimisation des processus métier',
      'Formation et support utilisateur',
      'Documentation technique et fonctionnelle'
    ]
  }
];

const education = [
  {
    degree: 'Formation Odoo Certified',
    institution: 'Odoo S.A.',
    year: '2020'
  },
  {
    degree: 'Licence en Informatique',
    institution: 'Université',
    year: '2018'
  }
];

const certifications = [
  'Odoo Functional Consultant',
  'Odoo Technical Consultant',
  'Python Professional Certificate'
];

const technicalSkills = [
  { category: 'Langages', skills: ['Python', 'JavaScript', 'SQL', 'T-SQL', 'XML'] },
  { category: 'ERP & Frameworks', skills: ['Odoo', 'Odoo.sh', 'OWL', 'PostgreSQL'] },
  { category: 'Outils', skills: ['Git', 'Docker', 'VS Code', 'pgAdmin'] },
  { category: 'Méthodologies', skills: ['Agile', 'Scrum', 'ITIL'] }
];

const softSkills = [
  'Analyse des besoins',
  'Gestion de projet',
  'Communication client',
  'Formation utilisateur',
  'Résolution de problèmes',
  'Travail en équipe'
];
---

<Layout title="CV | Minoumissek Cedrigue Clauvis">
  <section class="cv-hero">
    <div class="container">
      <div class="cv-header">
        <div class="cv-title-wrapper">
          <span class="cv-tag font-mono">Curriculum Vitae</span>
          <h1 class="cv-title">Mon parcours <span class="text-gradient">professionnel</span></h1>
          <p class="cv-subtitle">
            Développeur Odoo ERP passionné avec plus de 5 ans d'expérience dans l'accompagnement
            des entreprises vers la transformation digitale.
          </p>
        </div>
        <div class="cv-actions">
          <a href="/cv.pdf" class="btn btn-primary" download>
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
              <polyline points="7 10 12 15 17 10"/>
              <line x1="12" y1="15" x2="12" y2="3"/>
            </svg>
            Télécharger CV
          </a>
        </div>
      </div>
    </div>
  </section>

  <section class="cv-content">
    <div class="container">
      <div class="cv-grid">
        <!-- Main Column -->
        <div class="cv-main">
          <!-- Experience -->
          <div class="cv-section">
            <h2 class="cv-section-title">
              <span class="section-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <rect x="2" y="7" width="20" height="14" rx="2" ry="2"/>
                  <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                </svg>
              </span>
              Expérience Professionnelle
            </h2>

            <div class="timeline">
              {experiences.map((exp, index) => (
                <div class="timeline-item" style={`animation-delay: ${index * 0.1}s`}>
                  <div class="timeline-marker"></div>
                  <div class="timeline-content">
                    <div class="timeline-header">
                      <div>
                        <h3 class="timeline-title">{exp.title}</h3>
                        <p class="timeline-company">{exp.company}</p>
                      </div>
                      <span class="timeline-period tag">{exp.period}</span>
                    </div>
                    <p class="timeline-description">{exp.description}</p>
                    <ul class="timeline-achievements">
                      {exp.achievements.map(achievement => (
                        <li>{achievement}</li>
                      ))}
                    </ul>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Technical Skills -->
          <div class="cv-section">
            <h2 class="cv-section-title">
              <span class="section-icon">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <polyline points="16 18 22 12 16 6"/>
                  <polyline points="8 6 2 12 8 18"/>
                </svg>
              </span>
              Compétences Techniques
            </h2>

            <div class="skills-table">
              {technicalSkills.map(skillGroup => (
                <div class="skill-row">
                  <span class="skill-category">{skillGroup.category}</span>
                  <div class="skill-tags">
                    {skillGroup.skills.map(skill => (
                      <span class="tag">{skill}</span>
                    ))}
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>

        <!-- Sidebar -->
        <div class="cv-sidebar">
          <!-- Education -->
          <div class="cv-section sidebar-section">
            <h2 class="cv-section-title">
              <span class="section-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M22 10v6M2 10l10-5 10 5-10 5z"/>
                  <path d="M6 12v5c3 3 9 3 12 0v-5"/>
                </svg>
              </span>
              Formation
            </h2>

            <div class="sidebar-list">
              {education.map(edu => (
                <div class="sidebar-item">
                  <h4 class="sidebar-item-title">{edu.degree}</h4>
                  <p class="sidebar-item-subtitle">{edu.institution}</p>
                  <span class="sidebar-item-date">{edu.year}</span>
                </div>
              ))}
            </div>
          </div>

          <!-- Certifications -->
          <div class="cv-section sidebar-section">
            <h2 class="cv-section-title">
              <span class="section-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="8" r="7"/>
                  <polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/>
                </svg>
              </span>
              Certifications
            </h2>

            <ul class="certifications-list">
              {certifications.map(cert => (
                <li class="certification-item">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polyline points="20 6 9 17 4 12"/>
                  </svg>
                  {cert}
                </li>
              ))}
            </ul>
          </div>

          <!-- Soft Skills -->
          <div class="cv-section sidebar-section">
            <h2 class="cv-section-title">
              <span class="section-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
                  <circle cx="9" cy="7" r="4"/>
                  <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
                  <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
                </svg>
              </span>
              Soft Skills
            </h2>

            <div class="soft-skills-grid">
              {softSkills.map(skill => (
                <span class="soft-skill-tag">{skill}</span>
              ))}
            </div>
          </div>

          <!-- Languages -->
          <div class="cv-section sidebar-section">
            <h2 class="cv-section-title">
              <span class="section-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="12" cy="12" r="10"/>
                  <line x1="2" y1="12" x2="22" y2="12"/>
                  <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
                </svg>
              </span>
              Langues
            </h2>

            <div class="languages-list">
              <div class="language-item">
                <span class="language-name">Français</span>
                <div class="language-level">
                  <span class="level-bar" style="width: 100%"></span>
                </div>
                <span class="level-label">Natif</span>
              </div>
              <div class="language-item">
                <span class="language-name">Anglais</span>
                <div class="language-level">
                  <span class="level-bar" style="width: 75%"></span>
                </div>
                <span class="level-label">Professionnel</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .cv-hero {
    padding: calc(72px + var(--space-4xl)) 0 var(--space-3xl);
    background: var(--bg-secondary);
    border-bottom: 1px solid var(--border-color);
  }

  .cv-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-2xl);
  }

  .cv-tag {
    display: inline-block;
    font-size: var(--text-sm);
    color: var(--accent-primary);
    margin-bottom: var(--space-md);
    letter-spacing: 0.1em;
  }

  .cv-title {
    font-size: var(--text-4xl);
    font-weight: 700;
    margin-bottom: var(--space-md);
  }

  .cv-subtitle {
    font-size: var(--text-lg);
    color: var(--text-secondary);
    max-width: 600px;
    line-height: 1.7;
  }

  .cv-content {
    padding: var(--space-4xl) 0;
  }

  .cv-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: var(--space-4xl);
  }

  .cv-section {
    margin-bottom: var(--space-3xl);
  }

  .cv-section-title {
    display: flex;
    align-items: center;
    gap: var(--space-md);
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-xl);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border-color);
  }

  .section-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    background: rgba(0, 217, 255, 0.1);
    border-radius: var(--radius-md);
    color: var(--accent-primary);
  }

  /* Timeline */
  .timeline {
    position: relative;
    padding-left: var(--space-xl);
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 6px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    background: var(--border-color);
  }

  .timeline-item {
    position: relative;
    padding-bottom: var(--space-2xl);
    animation: fadeInUp 0.5s ease forwards;
    opacity: 0;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: calc(-1 * var(--space-xl) + 2px);
    top: 8px;
    width: 12px;
    height: 12px;
    background: var(--accent-primary);
    border-radius: 50%;
    border: 3px solid var(--bg-primary);
  }

  .timeline-content {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
    transition: all var(--transition-base);
  }

  .timeline-content:hover {
    border-color: var(--accent-primary);
    box-shadow: var(--shadow-glow);
  }

  .timeline-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-md);
    margin-bottom: var(--space-md);
  }

  .timeline-title {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .timeline-company {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .timeline-period {
    flex-shrink: 0;
  }

  .timeline-description {
    color: var(--text-secondary);
    font-size: var(--text-sm);
    line-height: 1.6;
    margin-bottom: var(--space-md);
  }

  .timeline-achievements {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .timeline-achievements li {
    position: relative;
    padding-left: var(--space-lg);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .timeline-achievements li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--accent-primary);
  }

  /* Skills Table */
  .skills-table {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .skill-row {
    display: grid;
    grid-template-columns: 150px 1fr;
    gap: var(--space-lg);
    padding: var(--space-md) 0;
    border-bottom: 1px solid var(--border-color);
  }

  .skill-row:last-child {
    border-bottom: none;
  }

  .skill-category {
    font-weight: 600;
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  /* Sidebar */
  .sidebar-section {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: var(--radius-lg);
    padding: var(--space-xl);
  }

  .sidebar-section .cv-section-title {
    font-size: var(--text-base);
  }

  .sidebar-section .section-icon {
    width: 32px;
    height: 32px;
  }

  .sidebar-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .sidebar-item {
    position: relative;
    padding-left: var(--space-md);
    border-left: 2px solid var(--accent-primary);
  }

  .sidebar-item-title {
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .sidebar-item-subtitle {
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  .sidebar-item-date {
    font-size: var(--text-xs);
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
  }

  /* Certifications */
  .certifications-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .certification-item {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .certification-item svg {
    color: var(--accent-primary);
    flex-shrink: 0;
  }

  /* Soft Skills */
  .soft-skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .soft-skill-tag {
    padding: var(--space-xs) var(--space-sm);
    background: var(--bg-tertiary);
    border-radius: var(--radius-sm);
    font-size: var(--text-xs);
    color: var(--text-secondary);
  }

  /* Languages */
  .languages-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .language-item {
    display: grid;
    grid-template-columns: 80px 1fr auto;
    align-items: center;
    gap: var(--space-md);
  }

  .language-name {
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .language-level {
    height: 6px;
    background: var(--bg-tertiary);
    border-radius: 3px;
    overflow: hidden;
  }

  .level-bar {
    display: block;
    height: 100%;
    background: var(--accent-gradient);
    border-radius: 3px;
  }

  .level-label {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }

  /* Responsive */
  @media (max-width: 1024px) {
    .cv-grid {
      grid-template-columns: 1fr;
    }

    .cv-header {
      flex-direction: column;
    }
  }

  @media (max-width: 768px) {
    .cv-title {
      font-size: var(--text-3xl);
    }

    .timeline-header {
      flex-direction: column;
    }

    .skill-row {
      grid-template-columns: 1fr;
      gap: var(--space-sm);
    }
  }
</style>
